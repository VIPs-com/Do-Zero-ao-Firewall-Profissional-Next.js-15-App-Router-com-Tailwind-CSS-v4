# URL pública do site — usada por next/metadata (sitemap, OG image, canonical).
# Em dev pode ficar em http://localhost:3000.
# Em produção: https://seu-dominio.tld
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare Tunnel (docker-compose.yml) — token do túnel criado no
# Cloudflare Zero Trust → Networks → Tunnels. Só necessário para deploy via túnel.
# CF_TUNNEL_TOKEN="eyJ..."
